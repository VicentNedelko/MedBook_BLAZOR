<div class="container">
    <div class="row">
        <div class="col-md-offset-5 col-md-5" />
        <div class="col-md-2">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">@SpinnerText</span>
            </div>
        </div>
        <div class="col-md-offset-5 col-md-5" />
    </div>
</div>

@code{
    [Parameter]
    public string SpinnerText { get; set; } = string.Empty;
}